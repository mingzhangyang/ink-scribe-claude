{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ink-scribe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },

  // 自定义域名：orangely.xyz 需托管在同一 Cloudflare 账户，部署时会自动创建 DNS 记录与证书。
  // 两个域名提供同样的内容；分享链接、canonical 与站点地图统一使用 PUBLIC_BASE_URL（主域名 scribe.orangely.xyz）。
  "routes": [
    { "pattern": "scribe.orangely.xyz", "custom_domain": true },
    { "pattern": "ink-scribe.orangely.xyz", "custom_domain": true }
  ],

  // 前端由 Vite 构建为静态资源；API 与需要注入 SEO 信息的页面优先交给 Worker，其余路径走静态资源并在未命中时回退到 index.html（SPA）。
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/gallery", "/gallery/", "/guide", "/guide/", "/privacy", "/privacy/", "/terms", "/terms/", "/n/*", "/api/*", "/llms.txt", "/robots.txt", "/sitemap.xml"]
  },

  // Workers AI binding：所有模型调用都在 Worker 内发起，浏览器不接触任何凭据。
  "ai": { "binding": "AI" },

  // Workers Rate Limiting binding（按客户端 IP 计数）。若删除该绑定，Worker 会退化为单实例内存限流。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],

  // 发布的笔记与 API 密钥。首次部署前执行 `npx wrangler d1 create ink-scribe` 并把返回的 database_id 填到这里。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ink-scribe",
      "database_id": "9f2e36fe-cb99-441c-a352-1277b773d942",
      "migrations_dir": "migrations"
    }
  ],

  // 可选：开启 Workers Analytics Engine 以统计调用次数、延迟和 token 用量（不含用户原文）。
  // "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "ink_scribe_ai_usage" }],

  "vars": {
    // 模型与生成参数集中在这里配置；修改模型无需改动业务代码。详见 docs/model-evaluation.md。
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_DOODLE_MODEL": "",
    "AI_API_STYLE": "",
    "AI_RESPONSE_FORMAT": "",
    "AI_EXTRA_PARAMS": "",
    "AI_TEMPERATURE": "0.3",
    "AI_MAX_OUTPUT_TOKENS": "2048",
    "AI_TIMEOUT_MS": "45000",
    "AI_MAX_RETRIES": "1",
    "AI_GATEWAY_ID": "",
    "MAX_INPUT_CHARS": "12000",
    "MAX_BODY_BYTES": "81920",
    "RATE_LIMIT_PER_MINUTE": "12",
    "DOODLE_API_ENABLED": "false",
    "DOODLE_CACHE_TTL_SECONDS": "86400",
    "ALLOWED_ORIGINS": "",
    // 分享链接使用的站点地址；留空则使用请求的域名。本地开发与 mock 构建中会被清空
    "PUBLIC_BASE_URL": "https://scribe.orangely.xyz",
    "DEFAULT_TIMEZONE": "Asia/Shanghai",
    "API_RATE_LIMIT_PER_MINUTE": "30",
    // 不带密钥的 agent 发布：24 小时内全站与每个 IP 的上限，任一为 0 即关闭匿名发布。
    "ANON_PUBLISH_DAILY_LIMIT": "500",
    "ANON_PUBLISH_DAILY_LIMIT_PER_CLIENT": "20"
  },

  // Worker Previews（Workers Builds 为非生产分支执行 `wrangler preview`）。预览不继承上面的绑定与变量，需要在这里单独声明：
  // - vars 与生产保持一致（修改上面的 vars 时同步修改这里），只把 PUBLIC_BASE_URL 留空，分享链接指向预览自己的地址；
  // - 限流使用独立的 namespace_id，预览流量不占用生产额度；
  // - 不绑定 D1：预览不读写生产的笔记与 API 密钥。编辑器与 AI 整理照常可用，图库为空，发布接口返回 503 STORAGE_UNAVAILABLE。
  //   需要在预览中测试发布时，可另建数据库（npx wrangler d1 create ink-scribe-preview）并在这里加上 d1_databases。
  "previews": {
    "ai": { "binding": "AI" },
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 12, "period": 60 }
      }
    ],
    "vars": {
      "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
      "AI_DOODLE_MODEL": "",
      "AI_API_STYLE": "",
      "AI_RESPONSE_FORMAT": "",
      "AI_EXTRA_PARAMS": "",
      "AI_TEMPERATURE": "0.3",
      "AI_MAX_OUTPUT_TOKENS": "2048",
      "AI_TIMEOUT_MS": "45000",
      "AI_MAX_RETRIES": "1",
      "AI_GATEWAY_ID": "",
      "MAX_INPUT_CHARS": "12000",
      "MAX_BODY_BYTES": "81920",
      "RATE_LIMIT_PER_MINUTE": "12",
      "DOODLE_API_ENABLED": "false",
      "DOODLE_CACHE_TTL_SECONDS": "86400",
      "ALLOWED_ORIGINS": "",
      "PUBLIC_BASE_URL": "",
      "DEFAULT_TIMEZONE": "Asia/Shanghai",
      "API_RATE_LIMIT_PER_MINUTE": "30",
      "ANON_PUBLISH_DAILY_LIMIT": "500",
      "ANON_PUBLISH_DAILY_LIMIT_PER_CLIENT": "20"
    }
  }
}
