{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ink-scribe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // @cloudflare/puppeteer（可选的 Browser Rendering 客户端）依赖 Node.js 兼容层
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 前端由 Vite 构建为静态资源；/api/* 优先交给 Worker，其余路径走静态资源并在未命中时回退到 index.html（SPA）。
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/n/*", "/llms.txt"]
  },

  // Workers AI binding：所有模型调用都在 Worker 内发起，浏览器不接触任何凭据。
  "ai": { "binding": "AI" },

  // Workers Rate Limiting binding（按客户端 IP 计数）。若删除该绑定，Worker 会退化为单实例内存限流。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],

  // 发布的笔记与 API 密钥。首次部署前执行 `npx wrangler d1 create ink-scribe` 并把返回的 database_id 填到这里。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ink-scribe",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ---- 可选：笔记预览图（图库缩略图、链接预览图片），默认关闭 ----
  // 需要 Workers 付费计划（Browser Rendering）。启用步骤：
  //   1. npx wrangler r2 bucket create ink-scribe-images
  //   2. npx wrangler queues create ink-scribe-render
  //   3. 取消下面三段配置的注释，并把 vars 中的 THUMBNAILS_ENABLED 改为 "true"
  // "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ink-scribe-images" }],
  // "queues": {
  //   "producers": [{ "binding": "RENDER_QUEUE", "queue": "ink-scribe-render" }],
  //   "consumers": [{ "queue": "ink-scribe-render", "max_batch_size": 4, "max_batch_timeout": 5, "max_retries": 3 }]
  // },
  // "browser": { "binding": "BROWSER" },

  // 可选：开启 Workers Analytics Engine 以统计调用次数、延迟和 token 用量（不含用户原文）。
  // "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "ink_scribe_ai_usage" }],

  "vars": {
    // 模型与生成参数集中在这里配置；修改模型无需改动业务代码。详见 docs/model-evaluation.md。
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_DOODLE_MODEL": "",
    "AI_API_STYLE": "",
    "AI_RESPONSE_FORMAT": "",
    "AI_EXTRA_PARAMS": "",
    "AI_TEMPERATURE": "0.3",
    "AI_MAX_OUTPUT_TOKENS": "2048",
    "AI_TIMEOUT_MS": "45000",
    "AI_MAX_RETRIES": "1",
    "AI_GATEWAY_ID": "",
    "MAX_INPUT_CHARS": "12000",
    "MAX_BODY_BYTES": "81920",
    "RATE_LIMIT_PER_MINUTE": "12",
    "DOODLE_API_ENABLED": "false",
    "DOODLE_CACHE_TTL_SECONDS": "86400",
    "ALLOWED_ORIGINS": "",
    // 分享链接使用的站点地址（例如 https://notes.example.com）；留空则使用请求的域名
    "PUBLIC_BASE_URL": "",
    "THUMBNAILS_ENABLED": "false",
    "DEFAULT_TIMEZONE": "Asia/Shanghai",
    "API_RATE_LIMIT_PER_MINUTE": "30"
  }
}
