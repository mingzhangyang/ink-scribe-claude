{
  "name": "ink-scribe",
  "private": true,
  "version": "0.1.0",
  "description": "墨语笔记 · InkScribe — AI 手写笔记工作室（Cloudflare Workers + Workers AI）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:models": "node --experimental-strip-types scripts/eval-models.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/long-cang": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
